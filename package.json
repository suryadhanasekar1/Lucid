{
  "name": "lucid",
  "version": "0.1.0",
  "private": true,
  "description": "Lucid — navigating the unknown for the everyday investor.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:phases": "tsx scripts/phase3-test.ts && tsx scripts/phase4-test.ts && tsx scripts/phase5-test.ts && tsx scripts/phase6-test.ts && tsx scripts/phase7-test.ts && tsx scripts/phase8-test.ts && tsx scripts/phase9-test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:phases",
    "setup:hooks": "bash scripts/setup-hooks.sh",
    "seed": "tsx scripts/seed-data.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.15.4",
    "snaptrade-typescript-sdk": "^9.0.83",
    "tailwind-merge": "^3.5.0",
    "yahoo-finance2": "^2.13.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "d3": "^7.9.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "happy-dom": "^15.7.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
