# .env.example
# Copy to .env.local. NEVER commit .env.local.

# ============================================
# REQUIRED — App will not start without these
# ============================================

# Anthropic Claude API
# Used by: Worry Translator, Headline Decoder, Tell-Me-More tooltips
# Get a key: https://console.anthropic.com/settings/keys
# Tier: Pay-as-you-go ($5 free credit). Hackathon cost: ~$2
ANTHROPIC_API_KEY=sk-ant-...

# SnapTrade
# Used by: "Connect your brokerage" primary flow
# Register at: https://snaptrade.com/login
# Tier: Free for development (sandbox)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_REDIRECT_URI=http://localhost:3000/connect/callback
# Optional for SnapTrade personal keys, which can only register one user.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ============================================
# REQUIRED FOR FULL FEATURE SET
# ============================================

# NewsAPI
# Used by: Headline Decoder trending feed
# Get a key: https://newsapi.org/register
# Tier: Free (100 req/day, dev only)
NEWSAPI_KEY=

# FRED (Federal Reserve Economic Data)
# Used by: "Today's Conditions" widget, scenario grounding, AI prompts
# Get a key: https://fred.stlouisfed.org/docs/api/api_key.html (60 sec signup)
# Tier: Free, no rate limit anxiety
FRED_API_KEY=

# SEC EDGAR User-Agent (REQUIRED — SEC will block requests without this)
# Format: "AppName ContactEmail"
SEC_EDGAR_USER_AGENT="Compass Hackathon manvith@example.com"

# ============================================
# NO KEY NEEDED — listed for documentation
# ============================================
# yahoo-finance2 — npm package, no key

# ============================================
# OPTIONAL
# ============================================
SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# CONFIG — Sensible defaults
# ============================================
RATE_LIMIT_AI_RPM=20
RATE_LIMIT_SNAPTRADE_RPM=10
MARKET_CACHE_TTL=3600
NEWS_CACHE_TTL=900
EDGAR_CACHE_TTL=86400  # 24 hours — fund holdings change quarterly
FRED_CACHE_TTL=86400   # 24 hours — macro updates monthly anyway

NEXT_PUBLIC_UI_VERSION=v1
NEXT_PUBLIC_ENABLE_SNAPTRADE=true
NEXT_PUBLIC_ENABLE_WORRY_TRANSLATOR=true
NEXT_PUBLIC_ENABLE_HEADLINE_DECODER=true
NEXT_PUBLIC_ENABLE_CIRCUIT_BREAKER=true
NEXT_PUBLIC_ENABLE_MACRO_CONDITIONS=true
